# 구글 시트 문서 ID
# https://docs.google.com/spreadsheets/d/<여기가 ID>/edit
GOOGLE_SHEET_ID=

# 서비스 계정 이메일 (예: shepherd-bot@my-project.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# 서비스 계정 키 JSON의 private_key 값.
# 줄바꿈이 \n 으로 들어간 형태 그대로 큰따옴표로 감싸서 붙여넣으면 된다.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 웹앱 공용 비밀번호. 비워 두면 링크를 아는 누구나 입력할 수 있다.
APP_PASSWORD=

# 관리 화면(/admin, 통계) 비밀번호. 비워 두면 APP_PASSWORD 를 대신 쓰고, 둘 다 없으면 잠그지 않는다.
ADMIN_PASSWORD=

# 1로 두면 구글 시트 없이 data/roster.ts 명단으로 화면만 둘러볼 수 있다.
# 저장은 여전히 실제 시트가 필요하므로, 배포 환경에는 넣지 말 것.
DEMO_ROSTER=
